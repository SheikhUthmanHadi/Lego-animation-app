{
  "name": "lego-animations-studio",
  "version": "0.1.0",
  "description": "Professional 3D LEGO animation application",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "SheikhUthmanHadi",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@react-three/fiber": "^8.14.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/postprocessing": "^2.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^r158",
    "zustand": "^4.4.0",
    "dexie": "^3.2.4",
    "uuid": "^9.0.0",
    "react-icons": "^4.11.0",
    "framer-motion": "^10.16.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/three": "^r158",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "electron-dev-installer": "^3.2.1",
    "wait-on": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron-dev": "concurrently \"wait-on http://127.0.0.1:5173 && electron .\" \"npm run dev\"",
    "electron-build": "npm run build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "build": {
    "appId": "com.lego-animations.studio",
    "productName": "LEGOAnimations Studio",
    "directories": {
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
